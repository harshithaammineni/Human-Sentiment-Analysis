# Model checkpoints (large files)
outputs/model_checkpoints/*.pth
outputs/model_checkpoints/*.pt
outputs/model_checkpoints/*.bin
!outputs/model_checkpoints/.gitkeep

# Logs / runs
runs/
tensorboard_logs/
wandb/

# Node / presentation dependencies
node_modules/
presentation/node_modules/

# OS
.DS_Store
Thumbs.db

